# SIGAA credentials (NUNCA commitar o .env real)
SIGAA_USER=seu_usuario
SIGAA_PASS=sua_senha

# true = roda sem janela (produção). false = mostra navegador (debug/primeiro teste)
HEADLESS=false

# Nome do grupo/lista no Google Tasks (vazio = "Minhas tarefas" padrao)
GOOGLE_TASKLIST=

# Topico ntfy.sh pra push de nova tarefa (vazio = sem notificacao). Use nome obscuro.
NTFY_TOPIC=
